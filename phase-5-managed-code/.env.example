# Cluster config for docker-compose. capture.sh auto-creates .env from this.
# Example defaults for a self-contained, single-host local dev cluster.
CLUSTER_SUBNET=172.28.0.0/16
BOOTSTRAP_IP=172.28.0.10
BOOTSTRAP_PORT=49737

# The app's signing secret (the manager's identity). The drive key is DERIVED from
# it, so the cluster's trust anchor is reproducible. In a real deployment this is a
# secret held only by the manager; here it is an example value.
CLUSTER_SEED=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# The PUBLIC drive key workers are configured to trust (derived from CLUSTER_SEED
# above). Workers replicate read-only by this key — they never see the seed.
# Reproduce with: bare -e to derive, or read it off the manager's drive-ready log.
DRIVE_KEY=609dcbc15a2eb538a3edc16ac600a63a52c4f2cc551946d53ea6a33932212ee3

# Which role each worker runs is NOT set here — it is data in the signed registry
# (manager builds it from assignments.json), read by each worker. Edit assignments.json
# to re-place responsibilities.

# Worker IDENTITY secrets, each = H(CLUSTER_SEED || <name>) (derived by the manager;
# handed to the worker so it is reachable at the matching public key in the registry).
# Precomputed here for the example CLUSTER_SEED above. The worker never sees the seed.
WORKER_A_SEED=2e3645e95bb91e5d10aa84cbda4bbed697ce24a8fb075ee2f7b9837fd005553e
WORKER_B_SEED=a64a102e0d11379b9c46e599c6151b6fcd7638096ed797145440ead887a1d7d4

# The worker the client targets BY KEY (resolved from the signed registry), and the
# service to call on it. echo runs on both workers, so this picks a specific node.
TARGET_WORKER=worker-b
TARGET_SERVICE=echo

# Execution pathway for the workers: 'memory' (P2P-native, no OS disk) or 'checkout'
# (materialize + require — the bridge to conventional execution).
EXEC=memory
