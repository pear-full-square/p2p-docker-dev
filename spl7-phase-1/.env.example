CLUSTER_SUBNET=172.30.0.0/16
BOOTSTRAP_IP=172.30.0.10
BOOTSTRAP_PORT=49737

# Signing seed — determines the drive key. Same seed = same drive key.
CLUSTER_SEED=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# Drive key (derived from CLUSTER_SEED). Start platform alone to get it from the log.
DRIVE_KEY=

# Host IP as seen from the browser (for WSL2: hostname -I | awk '{print $1}')
EXTERNAL_HOST=localhost
