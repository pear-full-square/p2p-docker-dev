# Cluster config for docker-compose. Copy to .env and adjust for your host
# (capture.sh does this automatically if .env is missing). These are example
# defaults for a self-contained, single-host local dev cluster.

# Docker bridge subnet for the cluster — any free private range.
CLUSTER_SUBNET=172.28.0.0/16

# The bootstrap node's address on that subnet (udx needs a concrete IPv4) + port.
BOOTSTRAP_IP=172.28.0.10
BOOTSTRAP_PORT=49737

# (Service names/roles are set in the compose commands — each name hashes to its
# own topic, so there's no single cluster topic here.)
