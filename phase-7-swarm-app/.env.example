# Swarm app config. Copy to .env before running.
CLUSTER_SUBNET=172.29.0.0/16
BOOTSTRAP_IP=172.29.0.10
BOOTSTRAP_PORT=49737

# The signing seed — determines the drive key. Same seed = same drive key.
# In production this is a secret held by the seed node operator.
CLUSTER_SEED=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# The PUBLIC drive key (derived from CLUSTER_SEED). Peers trust this key.
# Reproduce: start the seed node once and read the driveKey from the log.
DRIVE_KEY=

# The host IP as seen from the browser (WSL2 IP for Windows access).
# Find it with: hostname -I | awk '{print $1}'
EXTERNAL_HOST=172.17.219.203
